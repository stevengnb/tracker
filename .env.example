# Copy to .env.local and adjust for your deployment. All values are optional;
# sensible defaults are used when unset.

# ── Database & uploads ──
# Path to the SQLite database (default: ./logbook.db in the app's working dir).
# DB_PATH=/absolute/path/to/logbook.db
# Directory where uploaded files are stored (default: ./uploads).
# UPLOADS_DIR=/absolute/path/to/uploads

# ── Wiki ──
# A folder of Markdown files to browse read-only (e.g. an Obsidian vault).
# VAULT_DIR=/absolute/path/to/vault

# ── Logout button ──
# Where the logout button sends the browser. Unset → a local /logout path.
# For Cloudflare Access, point it at your team's logout endpoint:
# NEXT_PUBLIC_LOGOUT_URL=https://<team>.cloudflareaccess.com/cdn-cgi/access/logout
# NOTE: NEXT_PUBLIC_* vars are inlined at build time — set this BEFORE
# `npm run build`, not only in the runtime environment.

# ── Agent integration (the optional "Hermes" page) ──
# Only relevant if you run a companion agent; otherwise the page shows "no data".
# HERMES_HOME=/var/lib/hermes
# HERMES_CLI=/var/lib/hermes/venv/bin/hermes
# HERMES_USER=hermes
# HERMES_SESSIONS_DUMP=/usr/local/bin/hermes-sessions-dump
# GATEWAY_UNIT=hermes-gateway
# GATEWAY_LOG_PATH=
# STATE_DB_PATH=

# ── Cloudflare Access assertion verification (optional; off when unset) ──
# When BOTH are set, every route requires a valid Cf-Access-Jwt-Assertion
# header (RS256-verified against your team's JWKS, aud + iss checked).
# Leave unset in dev/staging where the proxy is absent.
# Team domain: <your-team>.cloudflareaccess.com (with or without https://).
# CF_ACCESS_TEAM_DOMAIN=
# AUD tag from the CF Zero Trust dashboard (Access → Applications → your app).
# CF_ACCESS_AUD=

# ── Same-origin gate override (optional) ──
# Mutating requests (POST/PUT/PATCH/DELETE) are rejected unless Sec-Fetch-Site
# or Origin indicates same-origin. By default the request's Host header is the
# allowed origin; set this only if your proxy rewrites Host.
# ALLOWED_ORIGIN=https://tracker.example.com

# Public hostname(s) the app answers besides localhost/127.0.0.1 — guards
# against DNS rebinding. Unset = no Host check.
# ALLOWED_HOSTS=tracker.example.com

# ── Backup endpoint ──
# /api/backup runs an out-of-tree shell script synchronously (blocks the event
# loop up to 60s). Hidden (404) unless set to "true" — flip on only while you
# intend to run a backup, then unset again.
# BACKUP_API_ENABLED=
