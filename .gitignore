# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ── Local / personal data — never commit ──
# The app reads ../logbook.db and ../uploads (outside this repo); guard anyway.
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal
# Database backups (e.g. logbook.db.bak.YYYYMMDD-HHMMSS) — not caught by *.db
*.bak
*.bak.*
*.db.bak*
/uploads/
/data/

# Python bytecode (from scripts/)
__pycache__/
*.pyc
!.env.example

# ── Colocated agent backend & local docs (not part of this app) ──
/cli.py
/puzzle_history.json
/venv/
/PRD-revamp.md
/.claude/

# ── Security audit artifacts (DB samples, host paths — never commit) ──
/piolium/
/docs/
